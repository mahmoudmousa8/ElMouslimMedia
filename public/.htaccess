DirectoryIndex index.html index.js index.php
Options -Indexes
RewriteEngine On
RewriteBase /

# Protect .builds
RewriteRule ^\.builds - [F,L]

# Direct file requests
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# SPA fallback to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
